{
  "openapi": "3.0.0",
  "info": {
    "title": "API Proxy Tickets - Hesk Help Desk Software",
    "version": "1.0.0"
  },
  "paths": {
    "/api/categories": {
      "get": {
        "tags": ["Hesk MySQL"],
        "summary": "Obtener categorías",
        "responses": {
          "200": { "description": "Lista de categorías" }
        }
      }
    },
    "/api/tickets": {
      "get": {
        "tags": ["Hesk MySQL"],
        "summary": "Obtener todos los tickets",
        "responses": {
          "200": { "description": "Lista de tickets" }
        }
      }
    },
    "/api/ticket/{id}": {
      "get": {
        "tags": ["Hesk MySQL"],
        "summary": "Obtener ticket por ID o TrackID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Puede ser el ID numérico (25) o el TrackID (A3D-2XJ-YP6P)",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "Detalles del ticket encontrados" },
          "404": { "description": "Ticket no encontrado" }
        }
      }
    },
    "/api/proxy/upload": {
      "post": {
        "tags": ["Proxy PHP"],
        "summary": "Subir adjunto",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "attachment": { "type": "string", "format": "binary" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Archivo subido" }
        }
      }
    },
    "/api/proxy/submit": {
      "post": {
        "tags": ["Proxy PHP"],
        "summary": "Enviar Ticket",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name", "email", "subject", "message", "category"],
                "properties": {
                  "name": { "type": "string", "example": "John Doe" },
                  "email": { "type": "string", "example": "john.doe@example.com" },
                  "subject": { "type": "string", "example": "Issue with my account" },
                  "message": { "type": "string", "example": "I am facing an issue with my account login." },
                  "category": { "type": "string", "example": "General Inquiry" },
                  "priority": { "type": "string", "enum": ["1", "2", "3"], "example": "2" },
                  "hy": { "type": "string", "example": "3" },
                  "hx": { "type": "string", "example": "" },
                  "file_key": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Ticket creado" }
        }
      }
    }
  }
}
